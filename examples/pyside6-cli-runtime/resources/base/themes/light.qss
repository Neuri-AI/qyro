QMainWindow, QWidget#appShell {
    background: #f7f8fc;
    color: #1e293b;
}
QFrame#appHeader {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
}
QLabel#appTitle { color: #0f172a; font-size: 25px; font-weight: 700; }
QLabel#appSubtitle, QLabel#pageDescription { color: #64748b; font-size: 13px; }
QLabel#pageTitle { color: #0f172a; font-size: 21px; font-weight: 700; }
QLabel#eyebrow { color: #ea580c; font-size: 11px; font-weight: 700; }
QTabWidget::pane { border: 0; top: -1px; }
QTabBar::tab {
    background: transparent; color: #64748b; padding: 10px 14px;
    margin: 0 2px; border-bottom: 2px solid transparent;
}
QTabBar::tab:selected { color: #c2410c; border-bottom-color: #ea580c; font-weight: 700; }
QFrame#card {
    background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px;
}
QFrame#card QLabel { color: #334155; }
QLabel#cardTitle { color: #0f172a; font-size: 15px; font-weight: 700; }
QLabel#muted, QLabel#devtoolsLink { color: #64748b; font-size: 12px; }
QLineEdit#field {
    background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px;
    color: #0f172a; padding: 9px 10px;
}
QLineEdit#field:focus { border: 2px solid #ea580c; }
QPushButton#primaryButton {
    background: #ea580c; border: 0; border-radius: 8px; color: #ffffff;
    font-weight: 700; padding: 9px 14px;
}
QPushButton#primaryButton:hover { background: #c2410c; }
QPushButton#themeToggle {
    background: #f1f5f9; border: 1px solid #cbd5e1; border-radius: 8px;
    color: #334155; font-weight: 600; padding: 8px 12px;
}
QPushButton#themeToggle:hover { background: #e2e8f0; }

QLabel{
    color: #1e293b;
}